+#[test]
+fn an_authenticated_package_with_a_classical_identity_suite_installs_nothing() {
+    use chur_format::backup::{
+        FinalBackupCommit, PREAMBLE_LEN, RECORD_HEADER_LEN, RecordCommitter, RecordHeader,
+        RecordType, manifest_key,
+    };
+
+    use chur_format::constants::BACKUP_VERSION_V2;
+
+    let source = scratch_root();
+    let mut session = vault::create(&source, PASSWORD, NOW)
+        .unwrap()
+        .activate()
+        .unwrap();
+    let root = session.root_secret().unwrap().duplicate();
+    let id = session.vault_id();
+    sync_receive::provision_local_identity(session.catalog().unwrap(), &root, id).unwrap();
+    let mut package = Cursor::new(Vec::new());
+    let summary = backup::create(&mut session, &mut package, NOW + 1, &mut Uninterrupted).unwrap();
+    let key = manifest_key(&root, &id).unwrap();
+    let bytes = package.get_mut();
+    let mut position = PREAMBLE_LEN;
+    let mut records = RecordCommitter::new();
+    let mut changed = false;
+    for index in 0..summary.record_count {
+        let header = RecordHeader::decode(&bytes[position..position + RECORD_HEADER_LEN]).unwrap();
+        position += RECORD_HEADER_LEN;
+        let length = usize::try_from(header.payload_length).unwrap();
+        let payload = &mut bytes[position..position + length];
+        position += length;
+        match header.record_type {
+            RecordType::Envelope => {
+                // The signing suite is the third u16. Preserve the envelope's
+                // actual length, protocol version, owner and recovery purpose.
+                assert_ne!(&payload[4..6], &[0, 1]);
+                payload[4..6].copy_from_slice(&[0, 1]);
+                changed = true;
+            }
+            RecordType::FinalCommit => {
+                assert!(changed);
+                let mut commit = FinalBackupCommit::open(
+                    payload,
+                    &key,
+                    &id,
+                    &summary.backup_id,
+                    BACKUP_VERSION_V2,
+                )
+                .unwrap();
+                commit.records.as_mut().unwrap().record_commitment = records.finish();
+                let sealed = commit
+                    .seal(&key, &id, &chur_crypto::Nonce::random().unwrap())
+                    .unwrap();
+                payload.copy_from_slice(&sealed);
+                continue;
+            }
+            RecordType::Container => continue,
+            _ => {}
+        }
+        records.add(index, header.record_type, payload);
+    }
+    assert_eq!(position, bytes.len());
+    let destination = scratch_root();
+    let error = backup::restore(&destination, &mut package, PASSWORD, &mut Uninterrupted)
+        .expect_err("classical signing suite must be refused");
+    assert_eq!(error.status(), chur_core::ChurStatus::UnsupportedSuite);
+    assert!(destination.registry_names().unwrap().is_empty());
+    assert_eq!(
+        std::fs::read_dir(destination.vaults())
+            .map(|entries| entries.count())
+            .unwrap_or(0),
+        0
+    );
+}
